# Bind address — only expose on VPN/LAN, not public internet
HOST=0.0.0.0
PORT=8787

# Must match AGENT_API_KEY in n8n node "Normalize ECUS Jobs"
API_KEY=CHANGE_ME

# stub = dry-run (log + fake success). pywinauto = real UI automation.
RPA_BACKEND=stub

# Path to ECUS Windows Forms executable
ECUS_EXE_PATH=C:\ECUSDATA\ECUS5VNACCS.exe

# Process name when ECUS is already open
ECUS_PROCESS_NAME=ECUS5VNACCS

# How many jobs may wait behind the one running on ECUS
JOB_QUEUE_MAX=200

# Max seconds one RPA job may run
JOB_TIMEOUT_SEC=540

# Dry-run delay in stub mode (seconds) — simulate typing time
STUB_DELAY_SEC=1

# Save screenshots on RPA failure
SCREENSHOT_ON_ERROR=true
SCREENSHOT_DIR=screenshots

LOG_LEVEL=INFO
LOG_DIR=logs
